# Reglas transversales del repositorio.
# Lo especifico de cada stack vive en su propio archivo:
#   server/.gitignore     compilacion y pruebas de .NET
#   client/.gitignore     dependencias y build de Node
#   database/.gitignore   volcados generados al depurar
#   postman/.gitignore    informes de newman


# --- Secretos y configuracion local -----------------------------------------
# Nunca se versionan. Las plantillas .env.example si, y son las que documentan
# que variables hacen falta.
.env
.env.*
!.env.example

# Volcado accidental de secretos de usuario de .NET.
secrets.json
appsettings.Local.json


# --- Docker ------------------------------------------------------------------
# Ajustes de maquina, no del proyecto: puertos distintos, volumenes propios.
docker-compose.override.yml
docker-compose.*.local.yml


# --- Editores e IDE ----------------------------------------------------------
.vs/
.idea/
*.swp
*~

# De .vscode solo se comparte lo que ayuda a otro desarrollador; el resto es
# configuracion personal.
.vscode/*
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json


# --- Sistema operativo -------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
._*


# --- Registros y temporales --------------------------------------------------
*.log
logs/
tmp/
temp/
