# Configuracion de Firebase Authentication.
# Copiar este archivo como .env y rellenar con los datos de la consola de Firebase
# (Configuracion del proyecto, seccion "Tus apps", app web).
#
# Si se dejan vacias, la pantalla de login lo detecta y ofrece entrar en modo
# demostracion, sin autenticacion. Es lo que permite revisar la aplicacion sin
# tener que crear un proyecto de Firebase.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional: solo lo usa Google Analytics, la autenticacion funciona sin el.
VITE_FIREBASE_MEASUREMENT_ID=

# Direcciones de los microservicios cuando se ejecuta "npm run dev" fuera de Docker.
CLIENTES_API=http://localhost:8081
CUENTAS_API=http://localhost:8082
