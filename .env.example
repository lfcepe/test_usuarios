# Copiar como .env y ajustar lo que haga falta. Todas las variables tienen un
# valor por defecto en docker-compose.yml, asi que el archivo es opcional.

# --- PostgreSQL ---
POSTGRES_USER=devsu
POSTGRES_PASSWORD=devsu2024
# Cambiar si el 5432 ya lo ocupa otra instalacion de PostgreSQL en la maquina.
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=devsu
RABBITMQ_PASSWORD=devsu2024

# --- Autenticacion Firebase en el backend ---
# Con false las APIs no exigen token, que es lo comodo para revisar con Postman.
FIREBASE_HABILITADO=false
FIREBASE_PROJECT_ID=

# --- Firebase en el frontend ---
# Vite las sustituye al compilar la imagen, no en tiempo de ejecucion.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Opcional: solo lo usa Google Analytics, la autenticacion funciona sin el.
VITE_FIREBASE_MEASUREMENT_ID=
